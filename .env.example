# ============================================================================
# Copia este archivo a .env (backend) o .env.local (frontend) y rellena valores.
# NUNCA subas archivos .env reales al repositorio.
# ============================================================================

# --- Backend (humanizer-backend*.js) ---
# Clave de OpenRouter para humanización con IA: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Puerto del backend (por defecto 3001)
PORT=3001

# Claves de servicios externos (opcionales según el backend usado)
GOOGLE_TRANSLATE_API_KEY=
TEXTCORTEX_API_KEY=
RAPIDAPI_KEY=
SAPLING_API_KEY=
RAPIDAPI_KEY_PA=
RAPIDAPI_SMODIN_KEY=

# --- Frontend (Vite, variables que empiezan por VITE_) ---
# Clave RapidAPI usada por el paso "Smodin" en el navegador.
# IMPORTANTE: cualquier clave expuesta al frontend es pública; prefiere
# mover esta llamada al backend en producción.
VITE_RAPIDAPI_SMODIN_KEY=

# URL base de la API en producción (en desarrollo se usa el proxy de Vite)
# VITE_API_URL=https://tu-backend.example.com
